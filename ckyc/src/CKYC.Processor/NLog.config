<?xml version="1.0" encoding="utf-8"?>
<!--
  NLog configuration for CKYCProcessor.exe.

  Two sinks by default:
    * Console — human-readable, single line. Preserves the CLI feel the commands currently
                produce with raw Console.WriteLine, so run.ps1 / CI output stays familiar.
    * File    — structured JSON, one event per line. Every named message-template parameter
                (e.g. {CustomerId}, {BatchKey}) is captured as a JSON property, so logs can be
                shipped to a central collector and queried by field. Rotates by size, keeps 10
                archives, and never interleaves NLog self-diagnostics into the business log.

  Relative file paths resolve against the process current working directory (the same place the
  rest of the pipeline writes custid.json / output files), so logs land next to wherever
  CKYCProcessor.exe is invoked — not the (possibly read-only) bin directory.

  Named message-template parameters only appear as JSON properties because includeAllProperties
  is true; the standard attributes below are always present.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="logs/ckyc-internal.log">

  <targets>
    <!-- Human-readable console: single line so run.ps1 / CI output stays clean. -->
    <target xsi:type="Console"
            name="console"
            layout="${longdate}|${level:upperCase=true}|${message}${onexception:inner= |${exception:format=tostring}}" />

    <!-- Structured JSON file: one object per line, auto-rotating. -->
    <target xsi:type="File"
            name="jsonfile"
            fileName="logs/ckyc-${shortdate}.json"
            archiveAboveSize="52428800"
            maxArchiveFiles="10"
            archiveNumbering="Date"
            archiveDateFormat="yyyyMMdd"
            encoding="utf-8">
      <layout xsi:type="JsonLayout"
              includeAllProperties="true"
              maxRecursionLimit="4"
              excludeProperties="CallSite;EventId">
        <attribute name="time" layout="${longdate}" />
        <attribute name="level" layout="${level}" />
        <attribute name="logger" layout="${logger}" />
        <attribute name="message" layout="${message}" />
        <attribute name="exception" layout="${exception:format=tostring}" />
      </layout>
    </target>
  </targets>

  <rules>
    <!-- Business log: capture everything to the structured file. -->
    <logger name="*" minlevel="Trace" writeTo="jsonfile" />
    <!-- Console stays informative: Info and above for user-facing progress; Warnings/Errors for failures. -->
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
